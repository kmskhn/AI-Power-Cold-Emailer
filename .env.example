# Server Configuration
PORT=4000

# Groq Configuration
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# Gemini Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# OpenRouter Configuration
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here
OPENROUTER_MODEL=openrouter/free
OPENROUTER_APP_NAME=Personal Job Emailer
OPENROUTER_SITE_URL=http://localhost:4000

# AI Service Settings & Timeouts (optional overrides)
AI_OPENROUTER_TIMEOUT_MS=8000
# AI_TEXT_TIMEOUT_MS=15000
# AI_VISION_TIMEOUT_MS=20000
# AI_429_RETRY_DELAY_MS=1000
# AI_PROVIDER_COOLDOWN_MS=30000

# Optional server-side user data for Railway / cloud deployments
# USERS_JSON=[]
